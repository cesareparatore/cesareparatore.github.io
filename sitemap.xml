<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  >

  <title>404 — Cesare Paratore</title>

  <meta
    name="description"
    content="La pagina richiesta non è disponibile."
  >

  <meta name="robots" content="noindex, follow">
  <meta name="theme-color" content="#0B0B0A">
  <meta name="color-scheme" content="dark">

  <link rel="canonical" href="https://cesareparatore.github.io/404.html">
  <link rel="icon" type="image/svg+xml" href="/assets/images/cp-mark.svg">

  <style>
    :root {
      --bg: #0B0B0A;
      --light: #F1EFE8;
      --secondary: #A7A49C;
      --gutter: 5vw;
    }

    * {
      box-sizing: border-box;
    }

    html {
      min-height: 100%;
    }

    body {
      margin: 0;
      min-height: 100svh;

      display: grid;
      place-items: center;

      padding:
        4rem
        var(--gutter)
        5rem;

      background: var(--bg);
      color: var(--light);

      font-family:
        Arial,
        Helvetica,
        sans-serif;

      -webkit-font-smoothing: antialiased;
    }

    main {
      width: min(100%, 1100px);
    }

    .top {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 2rem;

      margin-bottom: clamp(5rem, 15vh, 10rem);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;

      color: inherit;
      text-decoration: none;

      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.14em;
    }

    .brand img {
      width: 28px;
      height: 28px;

      filter: invert(1);
    }

    .eyebrow {
      margin: 0 0 1.5rem;

      color: var(--secondary);

      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.18em;
    }

    h1 {
      margin: 0;

      font-size: clamp(5rem, 18vw, 13rem);
      line-height: 0.8;
      letter-spacing: -0.08em;
    }

    .message {
      max-width: 650px;

      margin-top: clamp(3rem, 7vw, 6rem);

      font-size: clamp(1.25rem, 2vw, 2rem);
      line-height: 1.35;
    }

    .message p {
      margin: 0;
    }

    .message p + p {
      margin-top: 0.75em;
      color: var(--secondary);
    }

    .home-link {
      display: inline-flex;
      align-items: center;
      gap: 0.9rem;

      margin-top: 3rem;

      padding-bottom: 0.5rem;

      border-bottom: 2px solid currentColor;

      color: inherit;
      text-decoration: none;

      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.12em;

      transition:
        gap 220ms ease,
        opacity 220ms ease;
    }

    .home-link:hover,
    .home-link:focus-visible {
      gap: 1.4rem;
      opacity: 0.65;
    }

    :focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 5px;
    }

    @media (max-width: 600px) {
      :root {
        --gutter: 6vw;
      }

      .top {
        margin-bottom: 6rem;
      }

      .brand span {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        transition: none !important;
      }
    }
  </style>
</head>

<body>
  <main>

    <div class="top">
      <a
        class="brand"
        href="/"
        aria-label="Cesare Paratore — Home"
      >
        <img
          src="/assets/images/cp-mark.svg"
          alt=""
          width="512"
          height="512"
        >
        <span>CESARE PARATORE</span>
      </a>

      <span
        class="eyebrow"
        aria-hidden="true"
      >
        404
      </span>
    </div>

    <p class="eyebrow">PAGINA NON TROVATA</p>

    <h1>404.</h1>

    <div class="message">
      <p>Questa pagina non esiste.</p>
      <p>
        Ma puoi tornare da dove sei partito.
      </p>
    </div>

    <a
      class="home-link"
      href="/"
    >
      TORNA ALLA HOME
      <span aria-hidden="true">→</span>
    </a>

  </main>
</body>
</html>
